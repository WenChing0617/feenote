<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 能暴露给别的应用的文件目录。

    只放「分享」用的那一个子目录，不要把整个应用目录开出去 ——
    分享出去的是 content:// URI，别的应用拿到的也只是这一个文件的临时读权限。

    对应的实际路径是：/sdcard/Android/data/com.wenqing.feenote/files/share/
-->
<paths>
    <external-files-path name="share" path="share/" />
    <!-- 兜底：万一 external 存储不可用（极少数机型），用内部目录里的同一结构 -->
    <files-path name="share_internal" path="share/" />
</paths>
