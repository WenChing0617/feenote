<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 「电脑同步」要连局域网里的电脑；除此之外应用不发任何网络请求 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 用来判断当前是不是连在 WiFi 上，好给出「连同一个 WiFi」的提示 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FeeNote">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.FeeNote">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            「分享到微信 / QQ」用。

            Android 7.0 起不允许把 file:// 直接塞进 Intent 给别的应用（会抛
            FileUriExposedException），必须走 FileProvider 换成 content:// URI。
            这个 Provider 不对外暴露（exported=false），只在自己应用的分享动作里
            通过 FLAG_GRANT_READ_URI_PERMISSION 临时授权给接收方。
            分享本身不需要任何额外权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
